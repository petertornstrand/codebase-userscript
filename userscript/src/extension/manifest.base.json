{
    "manifest_version": 3,
    "name": "Codebase",
    "description": "Improves the Codebase project management application.",
    "permissions": [
        "storage",
        "notifications"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://code.happiness.se/*",
                "https://happiness.codebasehq.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_start"
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Codebase settings"
    },
    "host_permissions": [
        "https://*.gravatar.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://*/*"
    ]
}
